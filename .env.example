# Copy this file to .env and fill in your actual values

# DeepSeek API Configuration
DEEP_SEEK_API=your_deepseek_api_key_here
DEEP_SEEK_MODEL=your_model_name_here
DEEP_SEEK_URI=your_deepseek_api_endpoint_here

# Example values (replace with your actual values):
# DEEP_SEEK_API=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEP_SEEK_MODEL=deepseek-chat
# DEEP_SEEK_URI=https://api.deepseek.com/v1